# Euler: environment variables
#
# Precedence, lowest to highest: defaults in code -> .env -> variables
# exported in your shell.

# ──────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0                    # 127.0.0.1 for loopback only
PORT=2718                       # under STAGE=local, 2719 is used if 2718 is busy
STAGE=beta                      # beta = hosted container | local = laptop. euler.sh dev sets local
UVICORN_RELOAD=false            # true = restart on code changes (development only)

# ──────────────────────────────────────────────────────────────────────────
# Watcher
# ──────────────────────────────────────────────────────────────────────────
EULER_WATCHER_ENABLED=true      # false = boot the API without the tick loop
EULER_WATCHER_INTERVAL_S=5      # seconds between ticks
EULER_TIMELINE_PATH=timeline.json   # relative paths resolve against the checkout
