{
  "name": "@quirq-ai/euler",
  "version": "1.0.0",
  "private": true,
  "description": "Euler: a local app home with one server, a shared dock, and directly mounted applications",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "bin": { "euler": "bin/euler.mjs" },
  "scripts": {
    "start": "node bin/euler.mjs",
    "dev": "node bin/euler.mjs",
    "setup": "node scripts/setup.mjs",
    "apps:check": "node scripts/apps-sync.mjs check",
    "apps:sync": "node scripts/apps-sync.mjs sync",
    "build": "node bin/euler.mjs --build",
    "test": "node --test tests/*.test.mjs",
    "nx": "nx"
  },
  "repository": { "type": "git", "url": "https://github.com/quirq-ai/euler.git" },
  "devDependencies": { "nx": "23.2.1", "pnpm": "9.12.3" },
  "nx": {
    "name": "euler-app",
    "includedScripts": ["start", "setup", "build", "test", "apps:check", "apps:sync"]
  }
}
