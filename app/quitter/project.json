{
  "name": "euler-quitter",
  "projectType": "application",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/setup.mjs quitter"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node bin/euler.mjs --build --app quitter"
      },
      "cache": false
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "app/quitter"
      },
      "cache": false
    }
  }
}
