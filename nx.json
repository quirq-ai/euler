{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "targetDefaults": {
    "start": { "cache": false },
    "dev": { "cache": false },
    "build": { "cache": false },
    "setup": { "cache": false },
    "migrate:app-data": { "cache": false },
    "apps:check": { "cache": false },
    "apps:sync": { "cache": false },
    "test": { "cache": false }
  },
  "tui": { "enabled": false }
}
